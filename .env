# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=guess_db
POSTGRES_PORT=5432

# Flask / Backend settings
FLASK_ENV=production
FLASK_APP=run.py
FLASK_DB_TYPE=postgres
FLASK_DB_HOST=postgres
FLASK_DB_USER=postgres
FLASK_DB_PASSWORD=postgres_password
FLASK_DB_NAME=guess_db

# Frontend Backend URL
REACT_APP_BACKEND_URL=

# Service ports
BACKEND_PORT=5000
NGINX_PORT=80
